# =============================================================================
# MANAGEY FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in real values.
# The .env file is in .gitignore and will NEVER be committed.
#
# IMPORTANT: All variables MUST start with REACT_APP_ or React will ignore them.
# IMPORTANT: Variables are baked in at build time. Rebuild after changing them.
# =============================================================================

# Backend API URL
# Local development: http://localhost:8000/
# Production: https://Njorogetracy.replit.dev/
REACT_APP_API_URL=http://localhost:8000/

# Disable source maps in production builds (smaller files, hides source code)
GENERATE_SOURCEMAP=false
